# Copy this file to .env and fill in your actual key.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TIMEOUT_SECONDS=120
DATABASE_URL=postgres://user:pass@localhost:5432/resume_analyzer?sslmode=disable
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFETIME=
DB_CONN_MAX_IDLE_TIME=
DB_PING_TIMEOUT=

OBJECT_STORE=local
LOCAL_STORE_DIR=./data

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Analysis prompt (v2_5 = v2_4 schema + JD-independent ATS readability/structure scoring)
ANALYSIS_PROMPT_VERSION=v2_5
ANALYSIS_VERSION=gpt-5-mini:v1

# S3 settings (required when OBJECT_STORE=s3)
# AWS_REGION is read by S3 clients. Queue usage forces us-east-1 regardless.
AWS_REGION=
S3_BUCKET=
S3_PREFIX=
SSE_KMS_KEY_ID=

# Queue settings (required for phase 3)
RA_SQS_QUEUE_URL=
RA_WORKER_CONCURRENCY=4
RA_SQS_VISIBILITY_TIMEOUT_SECONDS=300
RA_SHUTDOWN_TIMEOUT_SECONDS=30
RA_ASYNC_MODE=sqs



# Razorpay one-time report unlocks. The paywall stays off unless PAYWALL_ENABLED=true
# and all three Razorpay secrets are set. Prices are in minor units (paise / cents).
PAYWALL_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRICE_INR_PAISE=49900
PRICE_USD_CENTS=900
